@page "/login"

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using FinanceApp.Blazor.Client.DTOs
@using FinanceApp.Blazor.Client.Services
@using System.Net.Http.Json
@using MudBlazor

@inject IHttpClientFactory HttpClientFactory
@inject AuthTokenService TokenService
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="400px">
    <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>

    <MudTextField @bind-Value="_model.Username"
    Label="Username"
    Required="true" />

    <MudTextField @bind-Value="_model.Password"
    Label="Password"
    InputType="InputType.Password"
    Required="true"
    Class="mt-3" />

    <MudButton Variant="Variant.Filled"
    Color="Color.Primary"
    FullWidth="true"
    Class="mt-4"
    OnClick="LoginAsync">
        Login
    </MudButton>

    <MudText Class="mt-4">
        Don't have an account?
        <MudLink Href="/register">Register</MudLink>
    </MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudText Color="Color.Error" Class="mt-2">
            @_error
        </MudText>
    }
</MudPaper>

@code {
    private readonly LoginRequest _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var hasToken = await TokenService.HasTokenAsync();
        AuthState.SetAuthenticated(hasToken);

        if (hasToken)
            Navigation.NavigateTo("/operation-types");
    }

    private async Task LoginAsync()
    {
        _error = null;

        try
        {
            var client = HttpClientFactory.CreateClient("PublicApi");

            var response = await client.PostAsJsonAsync(
                "api/Users/login", _model);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Invalid credentials";
                return;
            }

            var result = await response.Content
                .ReadFromJsonAsync<LoginResponse>();

            if (result == null || string.IsNullOrEmpty(result.Token))
            {
                _error = "Invalid server response";
                return;
            }

            await TokenService.SetTokenAsync(result.Token);

            AuthState.SetAuthenticated(true);

            Navigation.NavigateTo("/operation-types", true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
