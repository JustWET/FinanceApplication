@page "/operations"

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using System.Net.Http.Json
@using FinanceApp.Blazor.Client.Shared
@using MudBlazor
@using DTOs
@using Blazored.LocalStorage

@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ILocalStorageService LocalStorage

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudPaper Class="pa-4" Elevation="2">

    <MudStack Row="true"
    AlignItems="AlignItems.Center"
    Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">Financial Operations</MudText>

        <MudButton Color="Color.Primary"
        Variant="Variant.Filled"
        StartIcon="@Icons.Material.Filled.Add"
        OnClick="OpenCreate">
            Create
        </MudButton>
    </MudStack>

    <MudDivider Class="my-4" />

    <MudTable Items="_items"
    Hover="true"
    Bordered="true"
    Striped="true"
    Dense="true"
    Elevation="0">

        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Align="Align.Right">Amount</MudTh>
            <MudTh Align="Align.Right">Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>
                @context.Date.ToString("yyyy-MM-dd")
            </MudTd>

            <MudTd>
                @context.OperationTypeName
            </MudTd>

            <MudTd>


                <MudChip Color="@(context.IsIncome ? Color.Success : Color.Error)"
                Variant="Variant.Filled"
                Size="Size.Small"
                T="bool">
                    @(context.IsIncome ? "Income" : "Expense")
                </MudChip>
            </MudTd>

            <MudTd>
                @context.Description
            </MudTd>

            <MudTd Align="Align.Right">
                <MudText Color="@(context.IsIncome ? Color.Success : Color.Error)">
                    @(context.IsIncome ? "+" : "-")@context.Amount.ToString("N2")
                </MudText>
            </MudTd>

            <MudTd Align="Align.Right">
                <MudButton Size="Size.Small"
                Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Edit"
                OnClick="() => OpenEdit(context)">
                    Edit
                </MudButton>

                <MudButton Size="Size.Small"
                Variant="Variant.Filled"
                Color="Color.Error"
                StartIcon="@Icons.Material.Filled.Delete"
                Class="ml-2"
                OnClick="() => Delete(context.Id)">
                    Delete
                </MudButton>
            </MudTd>
        </RowTemplate>

    </MudTable>

</MudPaper>

<MudDialog @bind-Visible="_dialogOpen">
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="decimal"
                          Label="Amount"
                          @bind-Value="_current.Amount" Validation="@(new Func<decimal, string?>(AmountValidation))"
                          Required="true" RequiredError="Amount is required!" />

            <MudTextField Label="Description"
                          @bind-Value="_current.Description"
                          Required="true" RequiredError="Description is required!" />

            <MudSelect T="Guid?"
                       Label="Operation Type"
                       @bind-Value="_current.OperationTypeId"
                       Required="true" RequiredError="Operation Type is required!">
                @foreach (var type in _operationTypes)
                {
                    <MudSelectItem Value="@type.Id">
                        @type.Name (@(type.IsIncome ? "Income" : "Expense"))
                    </MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary" OnClick="Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    bool success = false;
    MudForm form;

    private bool _dialogOpen;

    private List<FinancialOperationDto> _items = new();
    private List<OperationTypeLookupDto> _operationTypes = new();
    private FinancialOperationFormDto _current = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOperationTypes();
        await Load();
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        try
        {
            _items = await client.GetFromJsonAsync<List<FinancialOperationDto>>("api/FinancialOperations") ?? [];
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(ex.Message);
            throw;
        }
    }

    private async Task LoadOperationTypes()
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        try
        {
            _operationTypes =
                await client.GetFromJsonAsync<List<OperationTypeLookupDto>>("api/operationtypes") ?? [];

            await LocalStorage.SetItemAsync("operation-types", _operationTypes);
        }
        catch
        {
            var cached =
                await LocalStorage.GetItemAsync<List<OperationTypeLookupDto>>("operation-types");

            _operationTypes = cached ?? [];
        }
    }


    private void OpenCreate()
    {
        _current = new FinancialOperationFormDto();

        _dialogOpen = true;
    }

    private void OpenEdit(FinancialOperationDto item)
    {
        _current = new FinancialOperationFormDto
        {
            Id = item.Id,
            OperationTypeId = item.OperationTypeId,
            Amount = item.Amount,
            Date = item.Date,
            Description = item.Description
        };

        _dialogOpen = true;
    }

    private async Task Delete(Guid id)
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        await client.DeleteAsync($"api/FinancialOperations/{id}");

        await Load();
    }


    private async Task Save()
    {
        await form.Validate();

        if (!success)
            return;

        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        if (_current.Id == Guid.Empty)
            await client.PostAsJsonAsync("api/FinancialOperations", _current);
        else
            await client.PutAsJsonAsync(
                $"api/FinancialOperations/{_current.Id}", _current);

        _dialogOpen = false;

        await OnInitializedAsync();
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }

    private string? AmountValidation(decimal amount)
    {
        if (amount <= 0)
            return "Amount must be greater than zero!";
        return null;
    }
}