@page "/operation-types"

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using System.Net.Http.Json
@using FinanceApp.Blazor.Client.Shared
@using MudBlazor
@using DTOs
@using Services

@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudPaper Class="pa-4" Elevation="2">

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">Operation Types</MudText>

        <MudButton Color="Color.Primary"
        Variant="Variant.Filled"
        StartIcon="@Icons.Material.Filled.Add"
        OnClick="OpenCreate">
            Create
        </MudButton>
    </MudStack>

    <MudDivider Class="my-4" />

    <MudTable Items="_items"
    Hover="true"
    Bordered="true"
    Striped="true"
    Dense="true"
    Elevation="0">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh Align="Align.Right">Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Name</MudTd>

            <MudTd>
                <MudChip Color="@(context.IsIncome ? Color.Success : Color.Error)"
                Variant="Variant.Filled"
                Size="Size.Small"
                T = "bool">
                    @(context.IsIncome ? "Income" : "Expense")
                </MudChip>
            </MudTd>

            <MudTd Align="Align.Right">
                <MudButton Size="Size.Small"
                Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Edit"
                OnClick="() => OpenEdit(context)">
                    EditS
                </MudButton>

                <MudButton Size="Size.Small"
                            Variant="Variant.Filled"
                            Color="Color.Error"
                            StartIcon="@Icons.Material.Filled.Delete"
                            Class="ml-2"
                            Disabled="@IsDeleteDisabled(context.Id)"
                            OnClick="() => Delete(context.Id)">
                    Delete
                </MudButton>
            </MudTd>
        </RowTemplate>

    </MudTable>

</MudPaper>

    <MudDialog @bind-Visible="_dialogOpen">
        <DialogContent>
            <MudForm @ref="form" @bind-IsValid="@success">
                <MudTextField Label="Name"
                    @bind-Value="_current.Name"
                    Required="true" RequiredError="Name is required!"
                          Validation="ValidateName" />

                <MudText Typo="Typo.subtitle2" Class="mt-3">
                    Type
                </MudText>

                <MudRadioGroup @bind-Value="_current.IsIncome">
                    <MudRadio Value="true">Income</MudRadio>
                    <MudRadio Value="false">Expense</MudRadio>
                </MudRadioGroup>
             </MudForm>
        </DialogContent>

        <DialogActions>
        <MudButton OnClick="CloseDialog">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
        OnClick="Save">
            Save
        </MudButton>
        </DialogActions>
    </MudDialog>

@code {
    bool success = false;
    MudForm form;

    private List<OperationTypeDto> _items = new();
    private HashSet<Guid> _usedTypeIds = new();

    private bool _dialogOpen;
    private OperationTypeDto _current = new();

    private bool IsDeleteDisabled(Guid typeId) => _usedTypeIds.Contains(typeId);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
            Navigation.NavigateTo("/login");

        await Load();
        await LoadUsedTypes();
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        try
        {
            _items = await client.GetFromJsonAsync<List<OperationTypeDto>>("api/operationtypes") ?? [];
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(ex.Message);
            throw;
        }
    }

    private async Task LoadUsedTypes()
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        var usage = await client.GetFromJsonAsync<List<OperationTypeUsageDto>>(
                "api/operationtypes/type-usage") ?? [];

        _usedTypeIds = usage
            .Where(x => x.Count > 0)
            .Select(x => x.OperationTypeId)
            .ToHashSet();
    }

    private void OpenCreate()
    {
        _current = new OperationTypeDto();

        _dialogOpen = true;
    }

    private void OpenEdit(OperationTypeDto item)
    {
        _current = new OperationTypeDto
        {
            Id = item.Id,
            Name = item.Name,
            IsIncome = item.IsIncome,
            Description = item.Description
        };

        _dialogOpen = true;
    }

    private async Task Delete(Guid id)
    {
        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        await client.DeleteAsync($"api/operationtypes/{id}");

        await Load();
    }


    private async Task Save()
    {
        await form.Validate();

        if(!success)
            return;

        var client = HttpClientFactory.CreateClient("AuthorizedApi");

        if (_current.Id == Guid.Empty)
            await client.PostAsJsonAsync("api/operationtypes", _current);
        else
            await client.PutAsJsonAsync(
                $"api/operationtypes/{_current.Id}", _current);

        _dialogOpen = false;
        await Load();
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }

    private string? ValidateName(string name)
    {
        if (_items.Any(x =>
            x.Name.Equals(name, StringComparison.OrdinalIgnoreCase)
            && x.Id != _current.Id))
        {
            return "Operation type with this name already exists";
        }

        return null;
    }

}