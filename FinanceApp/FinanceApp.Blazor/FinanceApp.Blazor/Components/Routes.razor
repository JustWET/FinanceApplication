@using FinanceApp.Blazor.Client

<Router AppAssembly="typeof(Client._Imports).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData"
                   DefaultLayout="typeof(Client.Shared.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Client.Shared.MainLayout)">
            <p>Page not found</p>
        </LayoutView>
    </NotFound>
</Router>


